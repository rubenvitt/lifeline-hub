{
  "name": "lifeline-hub-frontend",
  "private": true,
  "version": "1.0.0-alpha.199",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "setup": "node scripts/setup-dev-env.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs src/api/openapi.json -o src/api/types.generated.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "doku:bilder": "node scripts/doku-bilder.mjs",
    "verify": "playwright test -c playwright.verify.config.ts",
    "zeichen-werte": "node scripts/zeichen-werte.mjs",
    "design-system": "node scripts/design-system/run.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@einsatzzeichen/core": "7.0.0",
    "@einsatzzeichen/maplibre": "7.0.0",
    "@einsatzzeichen/react": "7.0.0",
    "@einsatzzeichen/schema": "7.0.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/query-persist-client-core": "5.108.2",
    "@tanstack/react-query": "^5.108.2",
    "antd": "^6.7.1",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "hls.js": "1.7.4",
    "idb": "^8.0.4",
    "libheif-js": "1.23.5",
    "maplibre-gl": "^6.19.0",
    "mgrs": "^2.2.0",
    "proj4": "^2.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "remark-gfm": "^4.0.1",
    "terra-draw": "^1.40.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "~2.2.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-query-devtools": "^5.108.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0",
    "jsdom": "31.0.1",
    "msw": "^3.0.7",
    "oxc-parser": "0.159.0",
    "oxlint": "1.94.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
