{
  "name": "lifeline-hub-frontend",
  "private": true,
  "version": "1.0.0-alpha.184",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "setup": "node scripts/setup-dev-env.mjs",
    "dev": "vite",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "gen:types": "openapi-typescript src/api/openapi.json -o src/api/types.generated.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "doku:bilder": "node scripts/doku-bilder.mjs",
    "zeichen-werte": "node scripts/zeichen-werte.mjs",
    "design-system": "node scripts/design-system/run.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@einsatzzeichen/core": "6.13.0",
    "@einsatzzeichen/maplibre": "6.13.0",
    "@einsatzzeichen/react": "6.13.0",
    "@einsatzzeichen/schema": "6.13.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/query-persist-client-core": "5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "idb": "^8.0.4",
    "libheif-js": "1.23.5",
    "maplibre-gl": "^6.15.0",
    "mgrs": "^2.2.0",
    "proj4": "^2.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "30.0.1",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
