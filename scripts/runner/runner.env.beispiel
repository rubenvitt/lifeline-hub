# /etc/lifeline-runner/runner.env — Konfiguration aller Plätze des eigenen e2e-Runners
# (LLH-1666, scripts/runner/README.md). Keine Geheimnisse hier: das Token liegt in
# RUNNER_TOKEN_FILE mit Modus 600.
RUNNER_REPO=rubenvitt/lifeline-hub
RUNNER_TOKEN_FILE=/etc/lifeline-runner/token
# Muss der Repo-Variablen E2E_RUNNER entsprechen.
RUNNER_LABEL=lifeline-e2e
RUNNER_IMAGE=lifeline-runner:latest
# Je Container; vier Plätze auf 8 Kernen / 16 GB dürfen sich überbuchen, die Grenzen sind Deckel.
RUNNER_CPUS=3
RUNNER_MEMORY=6g
# Obergrenze des geteilten Compiler-Caches (sccache räumt nach LRU).
RUNNER_SCCACHE_SIZE=20G
RUNNER_NETWORK=lifeline-runner
