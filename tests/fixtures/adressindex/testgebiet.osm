    <tag k="addr:housenumber" v="13"/>
    <tag k="addr:postcode" v="12345"/>
    <tag k="addr:city" v="Musterstadt"/>
  </way>
  <!-- Straßen-Way ohne Adresse: kein Eintrag (Straßen kommen aus den Adressen) -->
  <node id="111" version="1" lat="52.6190000" lon="13.7790000"/>
  <node id="112" version="1" lat="52.6210000" lon="13.7820000"/>
