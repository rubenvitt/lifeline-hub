---
/**
 * Bildmarke „Lebenslinie“ (LFH-837): Pulslinie, die in einem Quadrat in `marke` endet.
 * Geometrie wörtlich aus `frontend/src/marke/bildmarkeGeometrie.ts`; die Linie trägt die
 * Textfarbe ihres Grundes (`currentColor`), das Quadrat ist immer Marke-Rot.
 */
interface Props {
  groesse?: number;
  titel?: string;
}
const { groesse = 22, titel } = Astro.props;
---

<svg
  class="bildmarke"
  viewBox="0 -189 396 378"
  width={groesse}
  height={groesse}
  role={titel ? 'img' : undefined}
  aria-label={titel}
  aria-hidden={titel ? undefined : 'true'}
>
  <path
    d="M0 0H86L136-110L198 110L248 0H324"
    fill="none"
    stroke="currentColor"
    stroke-width="54"
    stroke-linejoin="miter"
    stroke-miterlimit="10"></path>
  <rect x="324" y="-36" width="72" height="72" fill="#a8071a"></rect>
</svg>

<style>
  .bildmarke {
    display: block;
    flex: none;
  }
</style>
