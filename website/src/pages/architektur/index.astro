---
/**
 * Übersicht der Architekturdokumentation (LLH-1435): Einstieg aus `docs/architektur/README.md`,
 * die zwölf arc42-Kapitel in drei Gruppen, das Verzeichnis der Entscheidungen und der Abschnitt
 * zur Pflege. Gestaltung wie die Übersicht der Anwenderdoku (`pages/doku/index.astro`).
 */
import { getCollection } from 'astro:content';
import Grundriss from '../../layouts/Grundriss.astro';
import {
  STATUS_NAME,
  aufbereiten,
  inhaltAusReadme,
  klartext,
  kopfVon,
} from '../../daten/architektur';
import '../../styles/doku.css';
import '../../styles/architektur.css';

const alle = await getCollection('architektur');
const readme = alle.find((k) => k.id === 'README');
const kapitel = alle
  .filter((k) => k.id !== 'README')
  .map((k) => ({ id: k.id, body: k.body ?? '', html: k.rendered?.html ?? '', ...kopfVon(k.body ?? '') }))
  .sort((a, b) => a.nummer - b.nummer);
const entscheidungen = (await getCollection('entscheidungen')).sort((a, b) =>
  a.data.id.localeCompare(b.data.id),
);

const inhalt = inhaltAusReadme(readme?.body ?? '');
const stand = kopfVon(readme?.body ?? '').stand;
const readmeHtml = aufbereiten(readme?.rendered?.html ?? '', 'docs/architektur/README.md');
const einleitung = klartext(/<p>([\s\S]*?)<\/p>/.exec(readmeHtml)?.[1] ?? '');
/** Pflege und Abgrenzung: alles ab „## Pflege“ aus der README. */
const pflege = readmeHtml.slice(Math.max(0, readmeHtml.search(/<h2[^>]*>Pflege<\/h2>/)));

const GRUPPEN = [
  { nummer: '01', name: 'Ziele und Rahmen', von: 1, bis: 4 },
  { nummer: '02', name: 'Aufbau und Abläufe', von: 5, bis: 8 },
  { nummer: '03', name: 'Entscheidungen, Qualität, Risiken', von: 9, bis: 12 },
].map((g) => ({ ...g, kapitel: kapitel.filter((k) => k.nummer >= g.von && k.nummer <= g.bis) }));

const diagramme = kapitel.reduce(
  (summe, k) => summe + (k.body.match(/^```mermaid/gm) ?? []).length,
  0,
);
const risiken = (kapitel.find((k) => k.nummer === 11)?.body.match(/^\| R\d+ \|/gm) ?? []).length;
const eckzahlen = [
  { zahl: kapitel.length, wort: 'arc42-Kapitel' },
  { zahl: entscheidungen.length, wort: 'Entscheidungen mit Prüfung' },
  { zahl: diagramme, wort: 'Diagramme' },
  { zahl: risiken, wort: 'offene Risiken' },
];
---

<Grundriss
  titel="Architekturdokumentation · Lifeline Hub"
  beschreibung="Wie Lifeline Hub gebaut ist: Bausteine, Abläufe, Verteilung, Entscheidungen und Risiken nach arc42."
>
  <section class="doku-held" aria-labelledby="arch-titel">
    <div class="doku-held__innen">
      <div class="doku-held__text">
        <p class="doku-label doku-label--marke">Architekturdokumentation · arc42</p>
        <h1 class="doku-held__titel" id="arch-titel">Wie Lifeline Hub gebaut ist</h1>
        <p class="doku-held__einleitung">{einleitung}</p>
        <button class="doku-suchfeld doku-suchfeld--gross" type="button" data-such-oeffnen>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.75"
            ></circle>
            <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.75"></path>
          </svg>
          <span>Kapitel, Bausteine und Entscheidungen durchsuchen</span>
          <kbd class="mono" data-such-kuerzel>⌘K</kbd>
        </button>
        {stand && <p class="doku-stand mono">Stand {stand}</p>}
      </div>
      <dl class="doku-eckzahlen fugenraster">
        {
          eckzahlen.map((e) => (
            <div class="doku-eckzahl">
              <dt class="doku-eckzahl__wort">{e.wort}</dt>
              <dd class="doku-eckzahl__zahl mono">{e.zahl}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <div class="doku-leiste">
    <div class="doku-leiste__innen">
      <nav class="doku-sprung" aria-label="Abschnitte">
        {
          GRUPPEN.map((g) => (
            <a href={`#gruppe-${g.nummer}`} data-sprung={g.nummer}>
              {g.name}
              <span class="mono">{g.kapitel.length}</span>
            </a>
          ))
        }
        <a href="#entscheidungen" data-sprung="entscheidungen">
          Entscheidungen
          <span class="mono">{entscheidungen.length}</span>
        </a>
        <a href="#pflege" data-sprung="pflege">Pflege</a>
      </nav>
    </div>
  </div>

  <div class="doku-bereiche">
    {
      GRUPPEN.map((g) => (
        <section
          class="doku-bereich"
          id={`gruppe-${g.nummer}`}
          data-bereich={g.nummer}
          aria-labelledby={`gruppe-${g.nummer}-titel`}
        >
          <h2 class="doku-bereich__titel" id={`gruppe-${g.nummer}-titel`}>
            <span class="mono doku-bereich__nummer">{g.nummer}</span>
            {g.name}
          </h2>
          <ul class="doku-karten arch-karten">
            {g.kapitel.map((k) => (
              <li>
                <a class="doku-karte arch-karte" href={`/architektur/${k.id}/`}>
                  <span class="arch-karte__nummer mono">{String(k.nummer).padStart(2, '0')}</span>
                  <span class="doku-karte__titel">{k.titel}</span>
                  {inhalt[k.id] && <span class="doku-karte__kurz">{inhalt[k.id]}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section
      class="doku-bereich"
      id="entscheidungen"
      data-bereich="entscheidungen"
      aria-labelledby="entscheidungen-titel"
    >
      <h2 class="doku-bereich__titel" id="entscheidungen-titel">
        <span class="mono doku-bereich__nummer">04</span>
        Entscheidungen
      </h2>
      <p class="arch-abschnitt__text">
        Jede Entscheidung nennt die Dateien, für die sie gilt, ihre Regeln als MUST oder SHOULD und
        eine Prüfung, die in jedem Pull Request läuft. Herleitung und Einordnung:
        <a href="/architektur/09-architekturentscheidungen/">Kapitel 9</a>.
      </p>
      <ol class="arch-adr-liste">
        {
          entscheidungen.map((e) => (
            <li>
              <a class="arch-adr-zeile" href={`/architektur/entscheidungen/${e.id}/`}>
                <span class="arch-adr-zeile__id mono">{e.data.id}</span>
                <span class="arch-adr-zeile__titel">{e.data.titel}</span>
                <span class="arch-adr-zeile__meta mono">
                  <span class={`arch-status arch-status--${e.data.status}`}>
                    {STATUS_NAME[e.data.status]}
                  </span>
                  <span>{e.data.datum.split('-').reverse().join('.')}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="doku-bereich" id="pflege" data-bereich="pflege" aria-label="Pflege">
      <div class="doku-text arch-text arch-text--pflege">
        <Fragment set:html={pflege} />
      </div>
    </section>
  </div>
</Grundriss>

<script>
  const bereiche = document.querySelectorAll<HTMLElement>('[data-bereich]');
  const spruenge = document.querySelectorAll<HTMLAnchorElement>('[data-sprung]');
  let geplant = false;
  function markiere() {
    geplant = false;
    let aktuell = '';
    bereiche.forEach((b) => {
      if (b.getBoundingClientRect().top < 180) aktuell = b.dataset.bereich ?? '';
    });
    spruenge.forEach((a) => {
      if (a.dataset.sprung === aktuell) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  }
  addEventListener(
    'scroll',
    () => {
      if (!geplant) {
        geplant = true;
        requestAnimationFrame(markiere);
      }
    },
    { passive: true },
  );
  markiere();
</script>
