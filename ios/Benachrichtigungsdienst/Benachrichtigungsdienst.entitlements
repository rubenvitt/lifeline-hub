<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Berechtigungen der Notification Service Extension: dieselbe App Group (Zahl der Server) und
  derselbe Schlüsselbund (Schlüssel je Kennung) wie die App (App/LifelineHub.entitlements). Push
  empfängt nur die App. Geprüft in ios/AppTests/InfoPlistTests.swift.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.rubeen.lifeline.ios</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.rubeen.lifeline.ios.gemeinsam</string>
	</array>
</dict>
</plist>
