<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Berechtigungen des Mitteilungsdienstes der Helfer-App (ADR-0111): dieselbe App Group wie die App
  (Helfer/App/LifelineHelfer.entitlements). Sie dient hier als Schlüsselbund-Gruppe für den
  Schlüssel der Nutzlast (`LifelineSchluesselbundGruppe` in der Info.plist, Gemeinsam/Schluesselbund.swift).
  Push empfängt nur die App.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.rubeen.lifeline.helfer</string>
	</array>
</dict>
</plist>
