<?xml version="1.0" encoding="utf-8"?>
<!--
  Vertrauen der Hülle (Entwurf D2a): System-CAs und vom Nutzer installierte CAs (eigene CA eines
  Einsatzservers), keine Ausnahmen, kein Pinning, kein Klartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
