<?xml version="1.0" encoding="utf-8"?>
<!--
  Lifeline Helfer (ADR-0098, Regeln android/helfer/AGENTS.md): eine App mit einer Aufgabe, am Einsatz
  anmelden und die Position senden. Ortung nur im Vordergrund-Dienst vom Typ `location`, gestartet aus
  der geöffneten App; kein Recht für den Standort im Hintergrund.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nur zum Server der Kopplung (https, network_security_config.xml). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR-Code der Einladung. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Standort fein oder grob (die Person darf „ungefähr“ wählen), nur im Vordergrund-Dienst. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Der Ortungsdienst läuft als Vordergrund-Dienst vom Typ `location` mit Benachrichtigung. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ab Android 16 zeigt das System die Benachrichtigung des Dienstes als Live-Update. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Ohne Kamera bleibt „Code eingeben“; Standort braucht die App für ihre Aufgabe. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="true" />

    <!-- Keine Sicherung: das verschlüsselte Sitzungs-Cookie gehört in keine Cloud. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifelineHelfer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Einladung als Deeplink (`lifeline-helfer://anmelden?server=…#CODE`, HelferLink im Kern). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifeline-helfer" android:host="anmelden" />
            </intent-filter>
        </activity>

        <!-- Die einzige Stelle, die im Hintergrund sendet; nur aus der App gestartet (ADR-0098). -->
        <service
            android:name=".dienste.OrtungsDienst"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
