{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rubeen/.cargo/bin/cona index --quiet"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rubeen/.cargo/bin/cona hook PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rubeen/.cargo/bin/cona index --quiet --session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rubeen/.cargo/bin/cona hook PreToolUse"
          }
        ],
        "matcher": "Read|Grep"
      }
    ]
  }
}
